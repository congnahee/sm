{
  "version": 2,
  "routes": [
    { "src": "/", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }, "continue": true },
    { "src": "/index\\.html", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }, "continue": true },
    { "src": "/js/(.*)", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" }, "continue": true },
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
